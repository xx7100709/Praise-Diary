<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>讚美日記</title>
  <!-- 載入 Supabase SDK 與 基礎樣式 -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background-color: #f7f9fc; color: #333; padding: 20px; max-width: 600px; margin: 0 auto; }
    .header { text-align: center; margin-bottom: 20px; }
    .header h1 { font-size: 24px; color: #333; margin-bottom: 5px; }
    .header p { font-size: 14px; color: #8f9bb3; }
    .card { background: #fff; border-radius: 12px; padding: 15px; margin-bottom: 15px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
    textarea { width: 100%; height: 80px; border: 1px solid #e4e9f2; border-radius: 8px; padding: 10px; font-size: 16px; margin-bottom: 10px; resize: none; }
    button { width: 100%; background-color: #598bff; color: white; border: none; padding: 12px; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; }
    button:active { opacity: 0.8; }
    .entry-card { background: #fff; border-left: 4px solid #598bff; border-radius: 8px; padding: 12px 15px; margin-bottom: 10px; box-shadow: 0 1px 4px rgba(0,0,0,0.05); }
    .entry-date { font-size: 12px; color: #8f9bb3; margin-bottom: 5px; }
    .entry-content { font-size: 16px; color: #222b45; line-height: 1.4; white-space: pre-wrap; }
  </style>
</head>
<body>

  <div class="header">
    <h1>✨ 我的讚美日記 ✨</h1>
    <p>每天肯定自己一點點，累積好心情！</p>
  </div>

  <div class="card">
    <textarea id="diaryInput" placeholder="今天有哪些值得自我讚美的事呢？"></textarea>
    <button onclick="addEntry()">新增紀錄</button>
  </div>

  <div id="entriesList"></div>

  <script>
    // 請替換為你的 Supabase 設定
    const SUPABASE_URL = 'https://kfhviyqgrfycmbhuotru.supabase.co';
    const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtmaHZpeXFncmZ5Y21iaHVvdHJ1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc0ODM4NDUsImV4cCI6MjEwMzA1OTg0NX0.TCGksnMy7SCLmI8LxtwhhAnJaQ7vZhmid4M2poOxjBY';
    const supabase = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    // 頁面載入時讀取日記
    window.onload = fetchEntries;

    async function fetchEntries() {
      const { data, error } = await supabase
        .from('praise_diaries')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) {
        console.error('讀取失敗:', error);
        return;
      }

      const listDiv = document.getElementById('entriesList');
      listDiv.innerHTML = '';
      
      data.forEach(item => {
        const dateStr = new Date(item.created_at).toLocaleDateString('zh-TW');
        const card = document.createElement('div');
        card.className = 'entry-card';
        card.innerHTML = `
          <div class="entry-date">${dateStr}</div>
          <div class="entry-content">${escapeHtml(item.content)}</div>
        `;
        listDiv.appendChild(card);
      });
    }

    async function addEntry() {
      const input = document.getElementById('diaryInput');
      const text = input.value.trim();
      
      if (!text) {
        alert('請輸入讚美自己的內容喔！');
        return;
      }

      const { data, error } = await supabase
        .from('praise_diaries')
        .insert([{ content: text }]);

      if (error) {
        alert('儲存失敗：' + error.message);
      } else {
        input.value = '';
        fetchEntries(); // 重新整理列表
      }
    }

    function escapeHtml(text) {
      return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
  </script>
</body>
</html>
