const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

interface DiaryEntry {
  id: string;
  content: string;
  created_at: string;
}

export default function HomeScreen() {
  const [entries, setEntries] = useState<DiaryEntry[]>([]);
  const [inputText, setInputText] = useState('');
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    fetchEntries();
  }, []);

  const fetchEntries = async () => {
    try {
      setLoading(true);
      const { data, error } = await supabase
        .from('praise_diaries')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) throw error;
      if (data) setEntries(data);
    } catch (error: any) {
      console.log('Error fetching:', error.message);
    } finally {
      setLoading(false);
    }
  };

  const saveEntry = async () => {
    if (!inputText.trim()) {
      Alert.alert('提示', '請輸入讚美自己的內容喔！');
      return;
    }

    try {
      const { data, error } = await supabase
        .from('praise_diaries')
        .insert([{ content: inputText.trim() }])
        .select();

      if (error) throw error;

      if (data) {
        setEntries([data[0], ...entries]);
        setInputText('');
      }
    } catch (error: any) {
      Alert.alert('錯誤', '儲存失敗：' + error.message);
    }
  };

  return (
    <SafeAreaView style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.title}>✨ 我的讚美日記 ✨</Text>
        <Text style={styles.subtitle}>每天肯定自己一點點，累積好心情！</Text>
      </View>

      <View style={styles.inputContainer}>
        <TextInput
          style={styles.input}
          placeholder="今天有哪些值得自我讚美的事呢？"
          value={inputText}
          onChangeText={setInputText}
          multiline
        />
        <TouchableOpacity style={styles.button} onPress={saveEntry}>
          <Text style={styles.buttonText}>新增紀錄</Text>
        </TouchableOpacity>
      </View>

      <FlatList
        data={entries}
        keyExtractor={(item) => item.id}
        refreshing={loading}
        onRefresh={fetchEntries}
        renderItem={({ item }) => (
          <View style={styles.card}>
            <Text style={styles.cardDate}>
              {new Date(item.created_at).toLocaleDateString('zh-TW')}
            </Text>
            <Text style={styles.cardContent}>{item.content}</Text>
          </View>
        )}
        contentContainerStyle={styles.listContainer}
      />
    </SafeAreaView>
  );
}

